# Copy to .env.local to override. All values are optional.

# The app has no real backend: MSW serves the API in dev, e2e AND production builds.
# Set to "false" to disable the worker (you will only see error states).
VITE_ENABLE_MSW=true
# Show the floating mock-API settings panel outside dev (e.g. a hosted demo build).
VITE_MOCK_PANEL=false

# Mock API behaviour (can also be changed at runtime in the dev settings panel).
VITE_MOCK_LATENCY_MIN_MS=200
VITE_MOCK_LATENCY_MAX_MS=800
VITE_MOCK_FAILURE_RATE=0
VITE_MOCK_TRANSFER_TIMEOUT_RATE=0
VITE_MOCK_TIMEOUT_MODE=committed
VITE_MOCK_SEED=20260917

# Client request timeouts (ms)
VITE_REQUEST_TIMEOUT_MS=10000
VITE_TRANSFER_TIMEOUT_MS=10000
# Base delay for polling GET /transfers/:key after an unknown outcome (doubles, capped at 8s)
VITE_TRANSFER_POLL_BASE_MS=1000
# Base delay for retrying GET requests after a network error (2 retries, doubling)
VITE_GET_RETRY_BASE_MS=500
